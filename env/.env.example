# Copy this file to env/.env and fill in the providers you want to run.
# NEVER commit env/.env or any service-account JSON. Both are gitignored.

# --- Anthropic (Claude, direct API) ---
ANTHROPIC_API_KEY=

# --- OpenAI (GPT) ---
OPENAI_API_KEY=

# --- Google Gemini (API-key path) ---
GEMINI_API_KEY=

# --- Google Vertex (alternative to GEMINI_API_KEY) ---
# Place a service-account JSON anywhere in env/ and it is auto-detected, or set explicitly:
# GOOGLE_APPLICATION_CREDENTIALS=env/service-account.json
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Amazon Bedrock (Claude via Bedrock) ---
# Uses standard AWS credentials from your environment or a named profile; no key goes here.
# Set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION, or configure an AWS profile.
